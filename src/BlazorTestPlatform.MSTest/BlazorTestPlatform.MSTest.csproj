<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BlazorTestPlatform.MSTest</RootNamespace>
    <Description>MSTest integration for BlazorTestPlatform: stories and matrix cells as TestDataRow values with display names, categories and ignore messages, and story results that report skips as inconclusive tests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": consumers of this package also get the story generator and analyzers that ship in Core. -->
    <ProjectReference Include="..\BlazorTestPlatform.Core\BlazorTestPlatform.Core.csproj" PrivateAssets="none" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

</Project>
