<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>BlazorTestPlatform.Workbench</RootNamespace>
    <Description>The BlazorTestPlatform component workbench: browse stories across themes, viewports and render modes (Static SSR, Server, WebAssembly, Auto) and host them for real-browser visual, accessibility and interaction tests.</Description>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorTestPlatform.Workbench.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorTestPlatform.Core\BlazorTestPlatform.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
