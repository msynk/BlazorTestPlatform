<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BlazorTestPlatform.Reporting</RootNamespace>
    <Description>Reports for BlazorTestPlatform runs: a self-contained HTML report with visual-diff viewer, accessibility and performance details and failure timelines; JUnit XML; GitHub step summaries; and cross-run flake history.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": consumers of this package also get the story generator and analyzers that ship in Core. -->
    <ProjectReference Include="..\BlazorTestPlatform.Core\BlazorTestPlatform.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorTestPlatform.Reporting.Tests" />
  </ItemGroup>

</Project>
