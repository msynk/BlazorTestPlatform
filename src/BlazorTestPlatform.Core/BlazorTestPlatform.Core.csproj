<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BlazorTestPlatform</RootNamespace>
    <AssemblyName>BlazorTestPlatform.Core</AssemblyName>
    <Description>Core story, scenario, test-data, matrix, accessibility and performance model for BlazorTestPlatform. Driver-agnostic: the same stories run in bUnit, real browsers and the component workbench.</Description>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- The story-catalog source generator ships inside this package (analyzers/), so every consumer gets
       reflection-free, trimming-safe story discovery automatically. -->
  <ItemGroup>
    <ProjectReference Include="..\BlazorTestPlatform.Generators\BlazorTestPlatform.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\BlazorTestPlatform.CodeFixes\BlazorTestPlatform.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Packs the generator from wherever it was built (bin/, -output, -artifacts-path or UseArtifactsOutput). -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_BtpPackStoryGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_BtpPackStoryGenerator">
    <MSBuild Projects="..\BlazorTestPlatform.Generators\BlazorTestPlatform.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_BtpStoryGenerator" />
    </MSBuild>
    <MSBuild Projects="..\BlazorTestPlatform.CodeFixes\BlazorTestPlatform.CodeFixes.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_BtpStoryCodeFixes" />
    </MSBuild>
    <Error Condition="!Exists('@(_BtpStoryGenerator)')" Text="The story generator was not built: @(_BtpStoryGenerator). Build the solution (or the Generators project) before packing Core." />
    <Error Condition="!Exists('@(_BtpStoryCodeFixes)')" Text="The story code fixes were not built: @(_BtpStoryCodeFixes). Build the solution (or the CodeFixes project) before packing Core." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_BtpStoryGenerator)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="@(_BtpStoryCodeFixes)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorTestPlatform.Bunit" />
    <InternalsVisibleTo Include="BlazorTestPlatform.Playwright" />
    <InternalsVisibleTo Include="BlazorTestPlatform.Workbench" />
    <InternalsVisibleTo Include="BlazorTestPlatform.Core.Tests" />
  </ItemGroup>

</Project>
