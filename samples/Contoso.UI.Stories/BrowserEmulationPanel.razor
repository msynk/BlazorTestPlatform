@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@namespace Contoso.UI.Stories
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Fixture for the browser emulation stories: reads geolocation, connectivity and request timing from real browser APIs. *@
<section aria-label="Browser emulation">
    <button type="button" @onclick="LocateAsync">Locate me</button>
    <output aria-label="Position">@position</output>
    @* Written by the module on online/offline events, so it updates even when the circuit cannot reach the server. *@
    <output aria-label="Connection" @ref="connection"></output>
    <button type="button" @onclick="MeasureAsync">Measure a request</button>
    <output aria-label="Network">@network</output>
</section>

@code {
    private ElementReference connection;
    private Task<IJSObjectReference>? module;
    private string position = "Unknown";
    private string network = "Not measured";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await (await ModuleAsync()).InvokeVoidAsync("watchConnection", connection);
        }
    }

    private Task<IJSObjectReference> ModuleAsync() =>
        module ??= JS.InvokeAsync<IJSObjectReference>("import", "./_content/Contoso.UI.Stories/BrowserEmulationPanel.razor.js").AsTask();

    private async Task LocateAsync()
    {
        try
        {
            var coordinates = await (await ModuleAsync()).InvokeAsync<double[]>("locate");
            position = FormattableString.Invariant($"{coordinates[0]:F2}, {coordinates[1]:F2}");
        }
        catch (JSException ex)
        {
            position = "Unavailable: " + ex.Message;
        }
    }

    private async Task MeasureAsync()
    {
        var milliseconds = await (await ModuleAsync()).InvokeAsync<double>("measure");
        network = milliseconds >= 250 ? "Slow" : "Fast";
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            var imported = await module;
            await imported.InvokeVoidAsync("unwatchConnection", connection);
            await imported.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
    }
}
