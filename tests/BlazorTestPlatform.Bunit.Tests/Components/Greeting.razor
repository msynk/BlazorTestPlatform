<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name!</p>
        <AuthorizeView Roles="Admin" Context="admin">
            <Authorized><span>Admin tools</span></Authorized>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <p>Please sign in.</p>
    </NotAuthorized>
</AuthorizeView>
