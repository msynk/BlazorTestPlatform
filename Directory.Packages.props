<Project>

  <PropertyGroup>
    <AspNetCorePackageVersion>10.0.13</AspNetCorePackageVersion>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(AspNetCorePackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Test engines">
    <PackageVersion Include="bunit" Version="2.12.5" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Deque.AxeCore.Commons" Version="4.14.0" />
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="AngleSharp.Css" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup Label="Source generators">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup Label="Unit testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

</Project>
